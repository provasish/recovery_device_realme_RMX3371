ro.display.series=Realme Gt Neo 3T
ro.product.board=kona
ro.board.platform=kona
vendor.gatekeeper.disable_spu=true
ro.adb.secure=0
fbe.metadata.wrappedkey=true
ro.crypto.volume.filenames_mode=aes-256-cts
ro.crypto.dm_default_key.options_format.version=2
ro.crypto.volume.metadata.method=dm-default-key
ro.crypto.uses_fs_ioc_add_encryption_key=true
ro.vendor.qti.va_aosp.support=1
ro.virtual_ab.enabled=true
# 120 Hz preferred mode tears at TWRP frame rates; minuitwrp picks 60 Hz.
ro.twrp.drm.prefer_60hz=true
# Flashlight (Advanced > Flashlight on/off): the camera HAL drives these.
ro.twrp.flashlight.leds=led:torch_0,led:torch_1
ro.twrp.flashlight.switch=led:switch_2
ro.twrp.flashlight.level=100

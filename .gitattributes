# Keep line endings predictable for this Linux/Android build tree, which is
# often checked out on Windows. Shell/init/config files must stay LF or they
# break on-device (e.g. dash reports "umask: Illegal number: 077" for CRLF).
* text=auto

.gitattributes    text eol=lf
.gitignore        text eol=lf
*.sh              text eol=lf
*.py              text eol=lf
*.rc              text eol=lf
*.fstab           text eol=lf
*.flags           text eol=lf
*.prop            text eol=lf
*.mk              text eol=lf
*.bp              text eol=lf
*.md              text eol=lf
*.json            text eol=lf
*.xml             text eol=lf
recovery.wipe     text eol=lf
installer/update-binary text eol=lf

# Binary blobs: never convert line endings.
*.img             binary
*.bin             binary
*.so              binary
*.zip             binary
*.apk             binary
prebuilt/Image    binary
prebuilt/dtb      binary
recovery/root/system/bin/otaripper                                  binary
recovery/root/system/bin/qseecomd                                    binary
recovery/root/system/bin/android.hardware.gatekeeper@1.0-service-qti binary
recovery/root/system/bin/android.hardware.keymaster@4.0-service-qti  binary
recovery/root/system/bin/android.hardware.keymaster@4.1-service-qti  binary
